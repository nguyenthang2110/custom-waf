[
  {
    "id": "WAF-001-SQLI-UNION",
    "version": "1.0",
    "enabled": true,
    "metadata": {
      "category": "SQL Injection",
      "severity": "CRITICAL",
      "tags": [
        "sqli",
        "union-based",
        "owasp-a03"
      ],
      "description": "Detects UNION-based SQL injection attempts",
      "author": "NHT",
      "created": "2025-01-01"
    },
    "conditions": {
      "phase": "REQUEST",
      "targets": [
        "PATH",
        "QUERY",
        "BODY"
      ],
      "methods": [
        "GET",
        "POST",
        "PUT"
      ],
      "path_patterns": []
    },
    "transforms": [
      "URL_DECODE",
      "LOWERCASE",
      "COMPRESS_WHITESPACE"
    ],
    "patterns": [
      {
        "type": "REGEX",
        "pattern": "union.*select|select.*union",
        "flags": "i"
      },
      {
        "type": "TOKEN",
        "tokens": [
          "union",
          "select"
        ],
        "proximity": 20,
        "order": "sequential"
      }
    ],
    "scoring": {
      "anomaly_score": 5,
      "severity_multiplier": 1.5
    },
    "actions": [
      {
        "type": "LOG",
        "level": "WARNING"
      },
      {
        "type": "SCORE",
        "increment": 5
      }
    ],
    "exceptions": {
      "ips": [],
      "user_agents": [],
      "paths": [
        "/health",
        "/metrics"
      ]
    }
  },
