      "URL_DECODE",
      "LOWERCASE",
      "REMOVE_WHITESPACE"
    ],
    "patterns": [
      {
        "type": "REGEX",
        "pattern": "(and|or)\\d*=\\d*|(and|or)(true|false)",
        "flags": "i"
