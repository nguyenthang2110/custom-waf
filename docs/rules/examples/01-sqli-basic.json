[
  {
    "id": "WAF-001-SQLI-UNION",
    "version": "2.0",
    "enabled": true,

    "info": {
      "category": "sqli",
      "severity": "critical",
      "description": "UNION-based SQL injection — pattern signature",
      "tags": ["sqli", "owasp-a03", "cwe-89"],
      "author": "NHT",
      "created": "2026-05-13"
    },

    "when": {
      "methods": ["GET", "POST", "PUT"],
      "path_exclude": ["/health", "/metrics"]
    },

    "inspect": [
      { "source": "args" },
      { "source": "path" },
      { "source": "uri" }
    ],

    "transforms": [
      "url_decode",
      "lowercase",
      "compress_whitespace",
      "replace_comments"
    ],

    "detect": {
      "logic": "any",
      "patterns": [
        { "type": "regex", "value": "\\bunion\\b[\\s\\S]{0,40}\\bselect\\b" },
        { "type": "regex", "value": "\\bselect\\b[\\s\\S]{0,40}\\bunion\\b" }
      ]
    },

    "action": {
      "score": 5,
      "labels": ["attack:sqli", "sig:union"],
      "log": true,
      "block": false
    },

    "except": {
      "paths": ["/admin/sql-console"]
    }
  },

  {
    "id": "WAF-002-SQLI-BOOLEAN",
    "version": "2.0",
    "enabled": true,

    "info": {
      "category": "sqli",
      "severity": "high",
      "description": "Boolean-based SQLi (or 1=1 / and true)",
      "tags": ["sqli", "boolean-based", "owasp-a03"]
    },

    "when": {
      "methods": ["GET", "POST"]
    },

    "inspect": [
      { "source": "args" }
    ],

    "transforms": ["url_decode", "lowercase", "compress_whitespace"],

    "detect": {
      "logic": "any",
      "patterns": [
        { "type": "regex", "value": "\\b(or|and)\\b\\s+['\"]?\\d+['\"]?\\s*=\\s*['\"]?\\d+" },
        { "type": "regex", "value": "\\b(or|and)\\b\\s+(true|false)\\b" }
      ]
    },

    "action": {
      "score": 3,
      "labels": ["attack:sqli", "sig:boolean"],
      "log": true,
      "ml_confirm": {
        "enabled": true,
        "input": "args",
        "min_confidence": 0.75,
        "on_attack_add": 3,
        "on_normal_subtract": 3
      }
    }
  }
]
