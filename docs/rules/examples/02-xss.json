[
  {
    "id": "WAF-006-XSS-SCRIPT-TAG",
    "version": "2.0",
    "enabled": true,

    "info": {
      "category": "xss",
      "severity": "high",
      "description": "<script> tag injection",
      "tags": ["xss", "owasp-a03"]
    },

    "when": {
      "methods": ["GET", "POST", "PUT", "PATCH"]
    },

    "inspect": [
      { "source": "args" },
      { "source": "body" },
      { "source": "header", "name": "Referer" }
    ],

    "transforms": ["url_decode", "lowercase", "html_decode"],

    "detect": {
      "logic": "any",
      "patterns": [
        { "type": "regex", "value": "<script[\\s>]" },
        { "type": "regex", "value": "</script>" }
      ]
    },

    "action": {
      "score": 4,
      "labels": ["attack:xss"],
      "log": true
    },

    "except": {
      "path_prefixes": ["/admin/blog/preview"]
    }
  },

  {
    "id": "WAF-007-XSS-EVENT-HANDLER",
    "version": "2.0",
    "enabled": true,

    "info": {
      "category": "xss",
      "severity": "high",
      "description": "Inline event handlers: onerror=, onclick=, ...",
      "tags": ["xss", "event-handler"]
    },

    "inspect": [
      { "source": "args" },
      { "source": "body" }
    ],

    "transforms": ["url_decode", "lowercase", "html_decode", "compress_whitespace"],

    "detect": {
      "patterns": [
        { "type": "regex", "value": "\\bon(error|load|click|mouseover|focus|blur|submit|change|toggle)\\s*=" }
      ]
    },

    "action": {
      "score": 4,
      "labels": ["attack:xss", "sig:event-handler"],
      "log": true,
      "ml_confirm": {
        "enabled": true,
        "input": "args",
        "min_confidence": 0.70,
        "on_attack_add": 2,
        "on_normal_subtract": 2
      }
    }
  },

  {
    "id": "WAF-008-XSS-JS-PROTOCOL",
    "version": "2.0",
    "enabled": true,

    "info": {
      "category": "xss",
      "severity": "high",
      "description": "javascript: / data: URI in href/src",
      "tags": ["xss"]
    },

    "inspect": [
      { "source": "args" },
      { "source": "body" }
    ],

    "transforms": ["url_decode", "lowercase", "html_decode", "remove_whitespace"],

    "detect": {
      "logic": "any",
      "patterns": [
        { "type": "contains", "value": "javascript:" },
        { "type": "contains", "value": "data:text/html" },
        { "type": "contains", "value": "vbscript:" }
      ]
    },

    "action": {
      "score": 3,
      "labels": ["attack:xss"]
    }
  }
]
