[
  {
    "id": "WAF-024-SCANNER-UA",
    "version": "2.0",
    "enabled": true,

    "info": {
      "category": "scanner",
      "severity": "medium",
      "description": "Known scanner User-Agent (sqlmap, nikto, nmap, dirbuster, ...)",
      "tags": ["scanner", "fingerprint"]
    },

    "inspect": [
      { "source": "user_agent" }
    ],

    "transforms": ["lowercase"],

    "detect": {
      "patterns": [
        {
          "type": "wordlist",
          "values": [
            "sqlmap",
            "nikto",
            "nmap",
            "masscan",
            "wpscan",
            "dirbuster",
            "gobuster",
            "ffuf",
            "havij",
            "acunetix",
            "burp",
            "zaproxy",
            "metasploit",
            "wfuzz"
          ]
        }
      ]
    },

    "action": {
      "score": 5,
      "labels": ["attack:scanner"],
      "log": true,
      "track": {
        "enabled": true,
        "scope": "ip",
        "counter": "scanner_hits",
        "ttl_minutes": 30,
        "threshold": 3,
        "on_threshold_score": 5,
        "on_threshold_labels": ["repeat:scanner"]
      }
    }
  },

  {
    "id": "WAF-100-BOT-NO-ACCEPT-LANG",
    "version": "2.0",
    "enabled": true,

    "info": {
      "category": "bot",
      "severity": "low",
      "description": "Trình duyệt thật luôn gửi Accept-Language; thiếu → có thể là bot",
      "tags": ["bot", "heuristic"]
    },

    "when": {
      "methods": ["GET", "POST"],
      "exclude_labels": ["bypass:api-client"]
    },

    "inspect": [
      { "source": "header", "name": "Accept-Language" }
    ],

    "detect": {
      "patterns": [
        { "type": "equals", "value": "" }
      ]
    },

    "action": {
      "score": 1,
      "labels": ["bot:no-accept-lang"],
      "log": false
    },

    "except": {
      "path_prefixes": ["/api/", "/webhook/"]
    }
  }
]
