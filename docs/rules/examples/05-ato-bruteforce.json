[
  {
    "id": "WAF-103-ATO-BRUTE-LOGIN",
    "version": "2.0",
    "enabled": true,

    "info": {
      "category": "ato",
      "severity": "high",
      "description": "Brute force trên endpoint /login — quá 10 lần POST trong 5 phút từ cùng IP",
      "tags": ["ato", "brute-force", "behavioral"],
      "author": "NHT"
    },

    "when": {
      "methods": ["POST"],
      "path_prefix": ["/login", "/api/login", "/auth/signin"]
    },

    "inspect": [
      { "source": "path" }
    ],

    "detect": {
      "patterns": [
        { "type": "starts_with", "value": "/" }
      ]
    },

    "action": {
      "score": 0,
      "labels": ["endpoint:login-attempt"],
      "log": false,

      "track": {
        "enabled": true,
        "scope": "ip",
        "counter": "login_attempts",
        "ttl_minutes": 5,
        "threshold": 10,
        "on_threshold_score": 8,
        "on_threshold_labels": ["attack:brute-force"]
      }
    }
  },

  {
    "id": "WAF-104-ATO-CREDENTIAL-STUFFING-SESSION",
    "version": "2.0",
    "enabled": true,

    "info": {
      "category": "ato",
      "severity": "high",
      "description": "Credential stuffing trên cùng session — nhiều username khác nhau",
      "tags": ["ato", "credential-stuffing"]
    },

    "when": {
      "methods": ["POST"],
      "path_prefix": ["/login", "/api/login"]
    },

    "inspect": [
      { "source": "args" }
    ],

    "transforms": ["lowercase"],

    "detect": {
      "patterns": [
        { "type": "contains", "value": "username=" }
      ]
    },

    "action": {
      "score": 0,
      "track": {
        "enabled": true,
        "scope": "session",
        "counter": "stuffing_attempts",
        "ttl_minutes": 5,
        "threshold": 5,
        "on_threshold_score": 10,
        "on_threshold_labels": ["attack:credential-stuffing"]
      }
    }
  }
]
