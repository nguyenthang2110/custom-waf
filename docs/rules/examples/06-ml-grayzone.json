[
  {
    "id": "WAF-200-ML-GRAYZONE",
    "version": "2.0",
    "enabled": true,

    "info": {
      "category": "custom",
      "severity": "info",
      "description": "Khi score đã ở vùng nghi ngờ (3-7), gọi ML để xác định attack hay benign — điều chỉnh score theo verdict",
      "tags": ["ml", "gray-zone", "hybrid"]
    },

    "when": {
      "min_score": 3,
      "max_score": 7
    },

    "inspect": [
      { "source": "body" }
    ],

    "transforms": ["url_decode"],

    "detect": {
      "patterns": [
        { "type": "length_gt", "value": 0 }
      ]
    },

    "action": {
      "score": 0,
      "labels": ["ml:consulted"],
      "log": false,

      "ml_confirm": {
        "enabled": true,
        "input": "body",
        "min_confidence": 0.7,
        "on_attack_add": 3,
        "on_normal_subtract": 3
      }
    }
  },

  {
    "id": "WAF-201-ML-SIGNATURE-CONFIRM",
    "version": "2.0",
    "enabled": true,

    "info": {
      "category": "custom",
      "severity": "info",
      "description": "Sau khi rule signature SQLi/XSS đã match, gọi ML xác nhận để giảm false positive",
      "tags": ["ml", "confirmation"]
    },

    "when": {
      "require_labels": ["attack:sqli", "attack:xss"]
    },

    "inspect": [
      { "source": "body" }
    ],

    "detect": {
      "patterns": [
        { "type": "length_gt", "value": 0 }
      ]
    },

    "action": {
      "score": 0,
      "labels": ["ml:confirmation-attempted"],
      "log": false,

      "ml_confirm": {
        "enabled": true,
        "input": "body",
        "min_confidence": 0.80,
        "on_attack_add": 2,
        "on_normal_subtract": 4
      }
    }
  }
]
