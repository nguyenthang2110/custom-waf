@startuml erd
' Sơ đồ thực thể - liên kết (ERD) cho database WAF
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Times"
skinparam defaultFontSize 14
skinparam linetype ortho
skinparam ArrowColor #333333
skinparam ArrowThickness 1.2
skinparam class {
  BackgroundColor #FFF7C2
  BorderColor #555555
  HeaderBackgroundColor #FFE9A8
  FontSize 14
  AttributeFontSize 12
}
hide methods
hide circle

entity users {
  * id : BIGSERIAL <<PK>>
  --
  * username : VARCHAR UNIQUE
  * email : VARCHAR UNIQUE
  * password_hash : VARCHAR
  * role : VARCHAR <<CHECK in admin/editor/viewer>>
  * created_at : TIMESTAMPTZ
  * updated_at : TIMESTAMPTZ
}

entity audit_logs {
  * id : BIGSERIAL <<PK>>
  --
  * ts : TIMESTAMPTZ
  * client_ip : INET
  * method : VARCHAR
  * path : TEXT
  * score : NUMERIC
  * action : VARCHAR
  * matched_rules : JSONB
  * ml_consulted : BOOLEAN
  * ml_label : VARCHAR
  * ml_confidence : NUMERIC
  * canonical_text : TEXT
}

entity ip_lists {
  * id : BIGSERIAL <<PK>>
  --
  * ip : INET UNIQUE
  * list_type : VARCHAR <<CHECK in black/white>>
  * reason : TEXT
  * expires_at : TIMESTAMPTZ
  * created_at : TIMESTAMPTZ
  + created_by : BIGINT <<FK users.id>>
}

entity rule_overrides {
  * id : BIGSERIAL <<PK>>
  --
  * rule_id : VARCHAR
  * enabled : BOOLEAN
  + anomaly_score : NUMERIC
  * updated_at : TIMESTAMPTZ
  + updated_by : BIGINT <<FK users.id>>
}

entity config_kv {
  * id : BIGSERIAL <<PK>>
  --
  * key : VARCHAR UNIQUE
  * value : JSONB
  * updated_at : TIMESTAMPTZ
  + updated_by : BIGINT <<FK users.id>>
}

entity training_samples {
  * id : BIGSERIAL <<PK>>
  --
  * ts : TIMESTAMPTZ
  * canonical_text : TEXT
  + label : VARCHAR
  + source : VARCHAR
  + audit_log_id : BIGINT <<FK audit_logs.id>>
}

users ||--o{ ip_lists       : "tạo bởi"
users ||--o{ rule_overrides : "cập nhật bởi"
users ||--o{ config_kv      : "cập nhật bởi"
audit_logs ||--o{ training_samples : "phái sinh"

@enduml
