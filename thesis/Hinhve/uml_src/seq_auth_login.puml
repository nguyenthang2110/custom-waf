@startuml seq_auth_login
' Sequence diagram: luồng đăng nhập + cấp JWT
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Times"
skinparam defaultFontSize 14
skinparam sequenceArrowThickness 1.2
skinparam sequence {
  ArrowColor #333333
  LifeLineBorderColor #555555
  LifeLineBackgroundColor #FFFFFF
  ParticipantBorderColor #555555
  ParticipantBackgroundColor #E8F0FF
  ParticipantFontSize 13
  ActorBorderColor #444444
  ActorBackgroundColor #FFE0D0
  ActorFontSize 13
  MessageFontSize 12
}

actor User
participant "Browser" as B
participant "Auth Handler\n/waf-api/auth/login" as AH
participant "User Repo" as UR
database "PostgreSQL" as PG
participant "JWT Service\n(HS256)" as JWT

User -> B : nhập username + password
B -> AH : POST /waf-api/auth/login\n{username, password}
activate AH

AH -> UR : FindByUsername(u)
UR -> PG : SELECT
PG --> UR : row(id, hash, role, ...)
UR --> AH : User

AH -> AH : bcrypt.Compare(hash, pwd)

alt password sai
  AH --> B : 401 Unauthorized
else password đúng
  AH -> JWT : Sign({sub, role, exp})
  JWT --> AH : token
  AH --> B : 200 OK\nSet-Cookie: auth=<jwt>\n(HttpOnly, Secure, SameSite)\n+ body {token, role}
end
deactivate AH

== Truy cập tiếp theo ==

B -> AH : GET /waf-api/...\nCookie: auth=<jwt>
activate AH
AH -> JWT : Verify(token)
JWT --> AH : claims{sub, role}
AH -> AH : check role vs middleware\n(requireAdmin /\nrequireAdminForWrite / ...)

alt role không đủ
  AH --> B : 403 Forbidden
else role hợp lệ
  AH --> B : 200 + payload
end
deactivate AH

@enduml
