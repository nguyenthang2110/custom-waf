@startuml seq_request_lifecycle
' Sequence diagram: vòng đời một HTTP request đi qua WAF
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Times"
skinparam defaultFontSize 14
skinparam sequenceArrowThickness 1.2
skinparam sequence {
  ArrowColor #333333
  LifeLineBorderColor #555555
  LifeLineBackgroundColor #FFFFFF
  ParticipantBorderColor #555555
  ParticipantBackgroundColor #E8F0FF
  ParticipantFontSize 13
  ActorBorderColor #444444
  ActorBackgroundColor #FFE0D0
  ActorFontSize 13
  MessageFontSize 12
}

actor Client
participant "WAF\nMiddleware" as MW
participant "Parser /\nNormalizer" as PR
participant "State Store" as SS
participant "Rate Limiter" as RL
participant "Rule Engine" as RE
participant "ML Client" as MC
participant "ML Service\n(DistilBERT)" as ML
participant "Decision" as DC
participant "Audit Log" as AS
participant "Upstream" as UP

Client -> MW : HTTP request
activate MW

MW -> PR : Parse + Normalize
PR --> MW : ParsedRequest

MW -> SS : isBlacklisted(ip)?
SS --> MW : false

MW -> RL : allow(ip)?
RL --> MW : OK

MW -> RE : Evaluate(req)
activate RE
RE -> RE : apply transforms\nrun regex / token match
RE --> MW : matches + score
deactivate RE

alt score ∈ [4.0, 5.0)
  MW -> MC : Predict(canonical_text)
  activate MC
  MC -> ML : POST /predict
  ML --> MC : {label, confidence}
  MC --> MW : result
  deactivate MC
  MW -> MW : score ± bump/penalty
end

MW -> DC : Decide(score, thresholds)
DC --> MW : ALLOW | CHALLENGE | BLOCK

alt action = ALLOW
  MW -> UP : forward request
  UP --> MW : upstream response
  MW --> Client : response
else action = CHALLENGE
  MW --> Client : challenge page
else action = BLOCK
  MW --> Client : 403 / 429
end

MW -> AS : audit(score, matches, action)
AS -> AS : write Postgres + JSONL
deactivate MW

@enduml
