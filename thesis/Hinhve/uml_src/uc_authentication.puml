@startuml uc_authentication
' Use case phân rã: Xác thực và đăng ký tài khoản (mục 2.2.8)
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Times"
skinparam defaultFontSize 14
skinparam linetype ortho
skinparam usecase {
  BackgroundColor #FFF7C2
  BorderColor #555555
  FontSize 13
}
skinparam actor {
  BorderColor #333333
  FontSize 13
}
skinparam note {
  BackgroundColor #FFFBE0
  BorderColor #888888
  FontSize 12
}

actor "End user nội bộ\n(SecEng/DevOps/Dev)" as user
actor "User Store\n(PostgreSQL)" as db   << system >>

rectangle "UC: Xác thực và đăng ký" {
  usecase "Đăng nhập"                       as UC_LOGIN
  usecase "So khớp bcrypt\n(cost 10)"       as UC_BCRYPT
  usecase "Phát hành JWT (HS256)\nHttpOnly cookie / Bearer" as UC_JWT
  usecase "Đăng ký công khai"               as UC_REGISTER
  usecase "Ép vai trò = viewer\n(chống leo thang)" as UC_FORCE
}

note right of UC_FORCE
  Trường role KHÔNG nhận từ client.
  DB: CHECK(role IN admin/editor/viewer),
  UNIQUE(username, email).
end note

user --> UC_LOGIN
user --> UC_REGISTER

UC_LOGIN ..> UC_BCRYPT   : <<include>>
UC_LOGIN ..> UC_JWT      : <<include>>
UC_REGISTER ..> UC_FORCE : <<include>>

UC_LOGIN    --> db
UC_REGISTER --> db

@enduml
