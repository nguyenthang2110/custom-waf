@startuml uc_general
' Biểu đồ ca sử dụng tổng quát - hệ thống WAF
'   4 cụm × 3 use case = 12 use case (khớp text 2.2.1)
'   Actor chia HAI BÊN:
'     TRÁI  : End User, Attacker, ML Service  -> chỉ nối cụm "Xử lý lưu lượng"
'     PHẢI  : Viewer < Editor < Admin (kế thừa) -> nối 3 cụm còn lại
'   Bỏ include/extend ở overview (để dành cho các hình phân rã) cho gọn.
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Times"
skinparam defaultFontSize 14
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #FFF7C2
  BorderColor #555555
  FontSize 13
}
skinparam actor {
  BorderColor #333333
  FontSize 13
}
skinparam rectangle {
  BackgroundColor transparent
  BorderColor #888888
}
skinparam package {
  BackgroundColor #F5F8FF
  BorderColor #4A6FB5
  FontSize 14
  FontStyle bold
}
skinparam ArrowColor #333333
skinparam ArrowThickness 1.1
skinparam nodesep 22
skinparam ranksep 90

' ================= LEFT actors =================
actor "End User"   as enduser
actor "Attacker"   as attacker
actor "ML Service" as mlsvc << system >>

' giữ 3 actor trái xếp dọc theo thứ tự
enduser  -[hidden]down- attacker
attacker -[hidden]down- mlsvc

' ================= SYSTEM =================
rectangle "Hệ thống WAF" as SYS {

  package "Xử lý lưu lượng" as P1 {
    usecase "Kiểm tra & lọc\nrequest HTTP" as UC_FILTER
    usecase "ML gray-zone\nconfirm"        as UC_ML
    usecase "Rate limiting"                as UC_RATE
    UC_FILTER -[hidden]down- UC_ML
    UC_ML     -[hidden]down- UC_RATE
  }

  package "Quản lý cấu hình bảo mật" as P2 {
    usecase "Quản lý rule"                as UC_RULE
    usecase "Quản lý IP\nblack/whitelist" as UC_IP
    usecase "Cấu hình hệ thống"           as UC_CONF
  }

  package "Quan sát hệ thống" as P3 {
    usecase "Dashboard\nreal-time"      as UC_DASH
    usecase "Tra cứu\naudit log"        as UC_AUDIT
    usecase "Cảnh báo\nsự kiện bảo mật" as UC_ALERT
  }

  package "Quản trị nội bộ" as P4 {
    usecase "Đăng nhập\n/ Đăng ký" as UC_AUTH
    usecase "Cài đặt\ntài khoản"   as UC_ACCOUNT
    usecase "Quản trị\nngười dùng" as UC_USER
  }

  ' xếp 4 cụm theo cột dọc
  P1 -[hidden]down- P2
  P2 -[hidden]down- P3
  P3 -[hidden]down- P4
}

' ================= RIGHT actors (RBAC) =================
actor "Viewer" as viewer
actor "Editor" as editor
actor "Admin"  as admin

editor --|> viewer
admin  --|> editor

viewer -[hidden]down- editor
editor -[hidden]down- admin

' ===== Anchors ép vị trí trái/phải =====
' Actor trái xếp dọc canh theo cột use case của P1 -> giữ chúng nằm BÊN TRÁI
enduser  -[hidden]right- UC_FILTER
attacker -[hidden]right- UC_ML
mlsvc    -[hidden]right- UC_RATE
' Actor phải nằm BÊN PHẢI các cụm (link 'right' từ package => actor ở phải)
P2 -[hidden]right- editor
P3 -[hidden]right- viewer
P4 -[hidden]right- admin

' ================= ASSOCIATIONS =================
' --- TRÁI -> cụm xử lý lưu lượng ---
enduser  --> UC_FILTER
attacker --> UC_FILTER
mlsvc    --> UC_ML
' Rate limiting áp dụng cho chính luồng request đang lọc (quan hệ include)
UC_FILTER ..> UC_RATE : <<include>>

' --- PHẢI: Viewer (cơ sở) ---
viewer --> UC_DASH
viewer --> UC_AUDIT
viewer --> UC_AUTH
viewer --> UC_ACCOUNT

' --- Editor (kế thừa Viewer) ---
editor --> UC_RULE
editor --> UC_IP
editor --> UC_CONF

' --- Admin (kế thừa Editor) ---
admin --> UC_ALERT
admin --> UC_USER

@enduml
