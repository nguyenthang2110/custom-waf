@startuml uc_system_settings
' Use case phân rã: Cấu hình hệ thống (mục 2.2.6)
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Times"
skinparam defaultFontSize 14
skinparam linetype ortho
skinparam usecase {
  BackgroundColor #FFF7C2
  BorderColor #555555
  FontSize 13
}
skinparam actor {
  BorderColor #333333
  FontSize 13
}
skinparam note {
  BackgroundColor #FFFBE0
  BorderColor #888888
  FontSize 12
}

actor "Admin" as admin
actor "Config Store\n(PostgreSQL)" as cfg  << system >>
actor "WAF Runtime" as rt                   << system >>

rectangle "UC: Cấu hình hệ thống" {
  usecase "Cấu hình URL\nbackend đích"               as UC_BACKEND
  usecase "Cấu hình ngưỡng\nlog/challenge/block"     as UC_THRESH
  usecase "Cấu hình ML\n(endpoint, timeout)"         as UC_ML
  usecase "Cấu hình rate limit\n(rate, burst)"       as UC_RATE
  usecase "Bật/tắt xác thực\nbắt buộc dashboard"     as UC_AUTH
  usecase "Validate giá trị\n(block > challenge...)" as UC_VALIDATE
  usecase "Lưu & áp dụng\nruntime (hot)"             as UC_APPLY
}

note right of UC_VALIDATE
  Alt-flow: validate thất bại
  -> giữ cấu hình cũ, trả lỗi.
end note

admin --> UC_BACKEND
admin --> UC_THRESH
admin --> UC_ML
admin --> UC_RATE
admin --> UC_AUTH

UC_BACKEND ..> UC_VALIDATE : <<include>>
UC_THRESH  ..> UC_VALIDATE : <<include>>
UC_ML      ..> UC_VALIDATE : <<include>>
UC_RATE    ..> UC_VALIDATE : <<include>>
UC_AUTH    ..> UC_VALIDATE : <<include>>

UC_VALIDATE ..> UC_APPLY : <<include>>
UC_APPLY --> cfg
UC_APPLY --> rt

@enduml
