@startuml uc_user_management
' Use case phân rã: Quản lý người dùng (Admin)
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Times"
skinparam defaultFontSize 14
skinparam linetype ortho
skinparam usecase {
  BackgroundColor #FFF7C2
  BorderColor #555555
  FontSize 13
}
skinparam actor {
  BorderColor #333333
  FontSize 13
}
skinparam note {
  BackgroundColor #FFFBE0
  BorderColor #888888
  FontSize 12
}

actor "Admin" as admin
actor "User Repository" as repo

rectangle "UC: Quản lý người dùng" {
  usecase "Liệt kê\nuser" as UC_LIST
  usecase "Tạo user mới\n(chỉ định role)" as UC_CREATE
  usecase "Đổi role\n(promote/demote)" as UC_ROLE
  usecase "Xóa user" as UC_DEL
  usecase "Kiểm tra\nlast-admin" as UC_CHECK_ADMIN
  usecase "Chặn\nself-action" as UC_CHECK_SELF
}

note right of UC_CHECK_ADMIN
  Condition: thao tác làm
  giảm số admin về 0
  Extension Point: invariant
end note

note right of UC_CHECK_SELF
  Condition: target == current user
  Extension Point: invariant
end note

admin --> UC_LIST
admin --> UC_CREATE
admin --> UC_ROLE
admin --> UC_DEL

UC_ROLE ..> UC_CHECK_ADMIN : <<include>>
UC_ROLE ..> UC_CHECK_SELF : <<include>>
UC_DEL  ..> UC_CHECK_ADMIN : <<include>>
UC_DEL  ..> UC_CHECK_SELF : <<include>>

UC_LIST --> repo
UC_CREATE --> repo
UC_ROLE --> repo
UC_DEL --> repo
UC_CHECK_ADMIN --> repo

@enduml
